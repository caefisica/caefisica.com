{{- /*
One profile per person in data/physicists.json, at the person's slug. The profile copies what the sources say, so it stays up when CTI Vitae is down.
A photo is used only when static/images/fisicos/<slug>.jpg exists; docs/fisicos.md says which photos may go there.
A person with a written article at content/fisicos/<slug>/index.md gets that page instead, and the same template fills in the data.
*/ -}}
{{- range hugo.Data.physicists.people -}}
	{{- if os.FileExists (printf "content/fisicos/%s/index.md" .slug) }}{{ continue }}{{ end -}}
	{{- $params := dict "slug" .slug "description" (printf "Dónde estudió y dónde trabaja %s, según sus fichas públicas." .name) -}}
	{{- $photo := printf "images/fisicos/%s.jpg" .slug -}}
	{{- if os.FileExists (path.Join "static" $photo) }}{{ $params = merge $params (dict "images" (slice (printf "/%s" $photo))) }}{{ end -}}
	{{- $.AddPage (dict
		"path" .slug
		"title" .name
		"params" $params
		"dates" (dict "lastmod" (time.AsTime hugo.Data.physicists.fetched))
		"content" (dict "mediaType" "text/markdown" "value" "")
	) -}}
{{- end -}}
