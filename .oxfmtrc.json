{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "proseWrap": "always",
  "ignorePatterns": [
    // Conserva los archivos de terceros en su formato publicado.
    "assets/js/vendor/**",
    // Cada formateador se encarga de su tipo de archivo.
    "layouts/**",
    // Conserva las acciones de Hugo y los shortcodes del front matter.
    "archetypes/offering.md",
    "archetypes/professor.md"
  ]
}
