{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "proseWrap": "always",
  "ignorePatterns": [
    // Conserva los archivos de terceros en su formato publicado.
    "assets/js/vendor/**",
    // Cada formateador se encarga de su tipo de archivo.
    "layouts/**",
    // El bot de revisión escribe estos fragmentos; el formato cambiaría su LaTeX.
    "content/apuntes/**/p[0-9][0-9]-c[0-9][0-9].md",
    // Conserva las acciones de Hugo y los shortcodes del front matter.
    "archetypes/offering.md",
    "archetypes/professor.md"
  ]
}
