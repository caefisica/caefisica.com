{
  "name": "@caefisica/caefisica.com",
  "version": "0.9.6",
  "private": true,
  "author": "David Duran <contacto@altmails.com> (https://totallynotdavid.github.io/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/caefisica/caefisica.com.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/totallynotdavid"
  },
  "scripts": {
    "dev": "bun run build && hugo server --bind=127.0.0.1 --port=1313 --disableFastRender --buildDrafts --buildFuture",
    "build": "bun run copy:fonts && hugo --gc --minify && pagefind --site public",
    "build:preview": "bun run copy:fonts && hugo --gc --minify -D -F && pagefind --site public",
    "deps": "bun install --frozen-lockfile",
    "copy:fonts": "bun run deps && shx cp 'node_modules/katex/dist/fonts/*' static/fonts/",
    "check": "bun run --sequential --no-exit-on-error lint typecheck build",
    "fix": "bun run deps && gotmplfmt -w layouts data && oxfmt . && markdownlint-cli2 --fix '**/*.md' '!node_modules/**'",
    "lint": "bun run deps && bun run --parallel --no-exit-on-error 'lint:*'",
    "lint:scripts": "oxlint --deny-warnings assets/js config scripts",
    "lint:markdown": "markdownlint-cli2 '**/*.md' '!node_modules/**'",
    "lint:templates": "test -z \"$(gotmplfmt -l layouts data)\"",
    "lint:workflows": "actionlint",
    "lint:format": "oxfmt --check .",
    "typecheck": "bun run deps && tsc --noEmit",
    "deploy": "bun run build && bun run publish:cloudflare && bun run publish:netlify",
    "deploy:cloudflare": "bun run build && bun run publish:cloudflare",
    "deploy:netlify": "bun run build && bun run publish:netlify",
    "publish:cloudflare": "wrangler deploy",
    "publish:netlify": "netlify deploy --prod --no-build --dir public --site \"$NETLIFY_SITE_ID\"",
    "install:browser": "bun run deps && bunx playwright install --with-deps chromium",
    "screenshots": "bun run deps && bun scripts/screenshots.ts",
    "links": "lychee 'content/**/*.md'",
    "clean": "shx rm -rf public resources node_modules"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@thulite/images": "^3.3.4",
    "@types/node": "^26.6.5",
    "@types/youtube": "^0.3.0",
    "clipboard": "^2.0.11",
    "highlight.js": "^11.12.0",
    "instant.page": "^5.2.0",
    "katex": "^0.19.0",
    "lazysizes": "^5.3.2",
    "markdownlint-cli2": "^0.23.3",
    "mermaid": "^12.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pagefind": "1.5.2",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "defaults"
  ]
}
