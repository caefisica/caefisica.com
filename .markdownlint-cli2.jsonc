{
  "config": {
    "default": true,
    "MD001": false,
    "MD013": false,
    "MD024": false,
    "MD029": false, // This only works if you have a continuous list (p.s. we don't)
    "MD030": false,
    "MD033": false,
    "MD035": false, // oxfmt writes the rule after front matter as ***
    "MD034": false, // We use bare URLs on shortcodes
  },
  "ignores": [
    "node_modules",
    "CHANGELOG.md",
    // The review bot writes these chunks; they are model output, not prose.
    "content/apuntes/**/p[0-9][0-9]-c[0-9][0-9].md",
  ],
}
