/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Content-Security-Policy: {{- with hugo.Data.fixes.headers -}}default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; manifest-src {{ range .manifestsrc }}{{ print . " " }}{{ end }}; media-src 'self'; connect-src {{ range .connectsrc }}{{ print . " " }}{{ end }}; font-src {{ range .fontsrc }}{{ print . " " }}{{ end }}; form-action 'self'; frame-src {{ range .framesrc }}{{ print . " " }}{{ end }}; img-src {{ range .imgsrc }}{{ print . " " }}{{ end }}; worker-src {{ range .workersrc }}{{ print . " " }}{{ end }}; script-src {{ range .scriptsrc }}{{ print . " " }}{{ end }}; style-src {{ range .stylesrc -}}{{ print . " " }}{{ end -}}{{ end }}
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin
  Permissions-Policy: geolocation=(self)
  Access-Control-Allow-Origin: *

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/vendor/jost/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
